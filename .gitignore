# ============================================================
# 小邹RPA —— 仓库忽略规则
# 原则：只公开「源码 + 内置示例项目」；你自己的项目、账号密码、
#       打包产物，以及发行版专用的部件都不进库。
# 注意：gitignore 里 # 只有写在行首才算注释，别在规则后面写行尾注释。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]

# ---------- 虚拟环境（体积大，含 PyQt6 二进制）----------
.venv/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 崩溃日志 / 普通日志 ----------
crash.log
*.log

# ---------- 打包产物（几百 MB；要打包就跑 packaging/build.ps1）----------
dist/
build/
packaging/*.ico

# ---------- 发行版专用部件（本机保留，打包自己的 exe 照常用，只是不提交）----------
# main.py 里对它们的导入都是可选的：缺了照样能跑，直接进主界面。
# 启动广告海报
assets/求打赏.jpg
assets/求打赏.png
# 启动广告页
smart_tool/ui/splash.py
# 安装向导（选文件夹 / 建快捷方式 / 登记卸载）
smart_tool/setup_wizard.py
# 卸载程序 + 注册表卸载入口 + 建快捷方式
smart_tool/uninstall.py
smart_tool/core/uninstall_reg.py
smart_tool/core/shortcut.py
# 作者自己的开发进度笔记（含内部计划）
项目进度.md

# ---------- 用户项目：只公开内置示例，其它一律不进库 ----------
# 你自己的项目里可能存着账号密码、采集结果、登录态 cookie，别跟着代码走。
projects/*
!projects/采集示例-登录与采集/
# 示例项目里这些也不入库：自动备份 / 登录态 cookie / 采集结果 / 临时验证脚本
projects/采集示例-登录与采集/steps.json.bak*
projects/采集示例-登录与采集/auth/
projects/采集示例-登录与采集/records.jsonl
projects/_verify_*/
